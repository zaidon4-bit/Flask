# Required on Render/Railway production. For a local SQLite demo, leave blank.
# Copy the exact connection string from Supabase -> Connect. Use Session Pooler if needed.
DATABASE_URL_MAIN=

# Optional. If blank, each role reuses DATABASE_URL_MAIN (or local SQLite).
DATABASE_URL_COURSES=
DATABASE_URL_AUDIT=

# Generate a long random key for sessions; never commit your actual .env file.
SECRET_KEY=replace-with-a-long-random-secret

# Create the first admin only after both values are replaced with real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-long-password

# VdoCipher API secret remains server-side only.
VDOCIPHER_API_SECRET=

# One approved student device by default; replacement installations need admin review.
DEVICE_LIMIT=1
# Local HTTP demo: false. Render/Railway HTTPS deployment: app forces secure cookies on.
COOKIE_SECURE=false

# Example Supabase PostgreSQL URL (do not use these placeholders literally):
# DATABASE_URL_MAIN=postgresql://postgres.PROJECT_REF:DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Anti-sharing controls (all optional; defaults shown).
# A newer student login signs the older session out.
SINGLE_SESSION=true
# Moving watermark (email + phone) inside the VdoCipher player.
WATERMARK_ENABLED=true

# WhatsApp support contact shown to students when they need help changing devices.
# Use international digits only, without + or spaces; leave blank until configured.
SUPPORT_WHATSAPP_NUMBER=

